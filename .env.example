# ─── Site ─────────────────────────────────────────────────────────────────────
# Canonical production URL (used for SEO: sitemap, robots, Open Graph).
# Optional locally — defaults to https://www.taaranjain.com in lib/site.ts.
NEXT_PUBLIC_SITE_URL=https://www.taaranjain.com

# Google Search Console verification token (Settings → Ownership verification →
# HTML tag). Paste just the content="..." value here to verify the site.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─── Contact form (Gmail SMTP via nodemailer) ──────────────────────────────────
# EMAIL_APP_PASSWORD is a Google "App Password", not your account password.
# Create one at: https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password

# ─── Admin panel (/admin) ──────────────────────────────────────────────────────
# Credentials you use to log in to the dashboard. Keep these in .env.local only.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=choose-a-strong-password
# Secret used to sign the admin session cookie. Generate a random one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=generate-a-long-random-string
