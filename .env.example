# ─── Site ─────────────────────────────────────────────────────────────────────
# Canonical production URL (used for SEO: sitemap, robots, Open Graph).
# Optional locally — defaults to https://www.taaranjain.com in lib/site.ts.
NEXT_PUBLIC_SITE_URL=https://www.taaranjain.com

# Google Search Console verification token (Settings → Ownership verification →
# HTML tag). Paste just the content="..." value here to verify the site.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─── Database (Railway Postgres) ───────────────────────────────────────────────
# Stores contact-form leads (taaranjain_leads) and page views
# (taaranjain_analytics). Use Railway's DATABASE_PUBLIC_URL — the
# *.railway.internal URL only resolves inside Railway, not on Vercel or locally.
# Create the tables once with: npm run db:setup
DATABASE_URL=postgresql://postgres:password@host.proxy.rlwy.net:12345/railway

# ─── Contact form (Gmail SMTP via nodemailer) ──────────────────────────────────
# EMAIL_APP_PASSWORD is a Google "App Password", not your account password.
# Create one at: https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password

# ─── WhatsApp click-to-chat (optional) ─────────────────────────────────────────
# Optional override. Defaults to the number hardcoded in lib/site.ts, so the
# links work in production without any env config.
# Full international number, digits only — country code first, no +, spaces or
# dashes. e.g. India 89555 35949 -> 918955535949
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Portfolio chatbot (optional) ──────────────────────────────────────────────
# Without these the assistant still works, answering from the built-in static
# knowledge base (lib/chatbot/staticResponder.ts) instead of an LLM.
# Any OpenAI-compatible endpoint works; the model defaults if unset.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
